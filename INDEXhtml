<!doctype html><html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>THE GITA WAY CLASSES</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#090402;color:#ffe8a0;font-family:Georgia,serif}
.app{min-height:100vh;text-align:center;overflow:hidden;background:radial-gradient(circle at 50% 20%,#4b2708,transparent 30%),linear-gradient(160deg,#1c0b02,#080302)}
header{padding:22px 15px 8px}.logo{display:inline-block;border:1px solid #d8a936;border-radius:30px;padding:8px 17px;letter-spacing:2px}
h1{font-size:clamp(32px,9vw,60px);line-height:.95;margin:14px 0 5px;background:linear-gradient(#fff4a9,#ffc12e,#9b5204);color:transparent;background-clip:text;-webkit-background-clip:text}
.tag{font-size:12px;letter-spacing:2px;color:#c8a967}.hero{width:min(94%,520px);margin:20px auto}
.photo{width:min(72vw,300px);aspect-ratio:1;border-radius:50%;padding:7px;margin:auto;background:linear-gradient(135deg,#fff0a0,#b66b0b,#fff0a0);box-shadow:0 0 35px #b66b0b55}
.photo img{width:100%;height:100%;object-fit:cover;border-radius:50%;display:block}
.card{margin-top:20px;padding:18px;border-radius:24px;border:1px solid #d3a63d66;background:#ffffff0b;backdrop-filter:blur(10px)}
.mantra{font-size:13px;line-height:1.7;color:#f4d27b}.shloka{font-size:21px;line-height:1.45;margin:18px 0 8px;min-height:65px}.meaning{font-size:12px;color:#bda46b;min-height:40px}
.diya{height:45px;position:relative;margin:10px auto}.flame{position:absolute;left:50%;top:0;width:20px;height:30px;transform:translateX(-50%) rotate(45deg);border-radius:50% 0 50% 50%;background:#ffd35a;box-shadow:0 0 30px #ff9d00;animation:f .7s infinite alternate}.lamp{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:70px;height:20px;border-radius:50%;background:#a35b0a}
button{border:1px solid #d5a83e88;background:#d49a201c;color:#ffe8a0;border-radius:25px;padding:11px 17px;margin:6px;font-weight:bold}button.main{background:linear-gradient(135deg,#ffd85c,#bd7109);color:#281202;border:0}
.peacock{position:fixed;bottom:15px;font-size:38px;z-index:3;animation:p 3s ease-in-out infinite}.l{left:5px}.r{right:5px;transform:scaleX(-1)}
.particle,.petal{position:fixed;top:-20px;z-index:4;pointer-events:none;animation:fall linear forwards}.particle{width:3px;height:3px;border-radius:50%;background:#ffd75c;box-shadow:0 0 9px #ffad00}.petal{font-size:15px}
@keyframes f{to{transform:translateX(-50%) rotate(35deg) scale(1.1,.9)}}@keyframes p{50%{transform:translateY(-9px)}}@keyframes fall{to{transform:translate(var(--x),110vh) rotate(500deg);opacity:.1}}
</style></head><body><div class="app">
<div class="peacock l">🦚</div><div class="peacock r">🦚</div>
<header><div class="logo">✦ GITA WAY ✦</div><h1>THE GITA WAY<br>CLASSES</h1><div class="tag">WISDOM • DEVOTION • INNER PEACE</div></header>
<main class="hero"><div class="photo"><img src="data:image/webp;base64," alt="Srila Prabhupada"></div>
<section class="card"><div class="mantra">हरे कृष्ण हरे कृष्ण • कृष्ण कृष्ण हरे हरे<br>हरे राम हरे राम • राम राम हरे हरे</div>
<div id="s" class="shloka"></div><div id="m" class="meaning"></div>
<div class="diya"><div class="flame"></div><div class="lamp"></div></div>
<button class="main" id="play">▶ Play Hare Krishna Lofi</button><button id="mute">🔊 Sound</button><div id="status">Ready</div>
<audio id="audio"><source src="data:audio/mpeg;base64," type="audio/mpeg"></audio></section></main>
<p style="font-size:11px;color:#806a40;padding:20px">THE GITA WAY CLASSES • भगवद्गीता ज्ञान</p></div>
<script>
const a=document.getElementById('audio'),play=document.getElementById('play'),mute=document.getElementById('mute'),status=document.getElementById('status');
play.onclick=async()=>{if(a.paused){try{await a.play();play.textContent='⏸ Pause Music';status.textContent='♪ Playing'}catch(e){status.textContent='Tap Play again'}}else{a.pause();play.textContent='▶ Play Hare Krishna Lofi';status.textContent='Paused'}};
mute.onclick=()=>{a.muted=!a.muted;mute.textContent=a.muted?'🔇 Muted':'🔊 Sound'};
const q=[['कर्मण्येवाधिकारस्ते मा फलेषु कदाचन।','You have a right to perform your duty, but not to the fruits of action. — BG 2.47'],['यदा यदा हि धर्मस्य ग्लानिर्भवति भारत।','Whenever righteousness declines, I manifest Myself. — BG 4.7'],['मन्मना भव मद्भक्तो मद्याजी मां नमस्कुरु।','Fix your mind on Me and become My devotee. — BG 18.65'],['सर्वधर्मान्परित्यज्य मामेकं शरणं व्रज।','Simply surrender unto Me. — BG 18.66']];
let i=0;function sh(){document.getElementById('s').textContent=q[i][0];document.getElementById('m').textContent=q[i][1];i=(i+1)%q.length}sh();setInterval(sh,6500);
function drop(){let x=document.createElement('i');x.className=Math.random()<.75?'particle':'petal';x.textContent=x.className==='petal'?'🌸':'';x.style.left=Math.random()*100+'vw';x.style.setProperty('--x',(Math.random()*180-90)+'px');x.style.animationDuration=(5+Math.random()*7)+'s';document.body.appendChild(x);setTimeout(()=>x.remove(),13000)}setInterval(drop,250);
</script></body></html>
